manifest {
    name = 'histostate'
    description = 'Stage 3 CNN training runs on AWS Batch GPU instances'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.04.0'
}

params.container = env('HISTOSTATE_IMAGE')

process {
    container = params.container
    // pipefail: a crash in training must fail the job even though its output goes through tee.
    shell = ['/bin/bash', '-euo', 'pipefail']
}

profiles {
    // GPU queue: fits g4dn.xlarge and g5.xlarge (4 vCPUs, 16 GB, 1 GPU) after the ECS agent's share.
    gpu {
        params.device = 'cuda'
        process.queue = env('AWS_BATCH_GPU_QUEUE')
        process {
            withName: TRAIN { cpus = 4; memory = '12 GB'; accelerator = 1 }
        }
    }
    // CPU queue, for when no GPU quota is available: fits the 8 vCPU, 16 GB instances.
    cpu {
        params.device = 'cpu'
        process.queue = env('AWS_BATCH_CPU_QUEUE')
        process {
            withName: TRAIN { cpus = 8; memory = '12 GB' }
        }
    }
    // AWS Batch: each run is a Batch job, files move through S3. Values come from .env.
    // The work dir sits under work/, which the bucket expires after 30 days.
    aws {
        process.executor = 'awsbatch'
        workDir = env('AWS_S3_WORKDIR')
        params.outdir = env('AWS_S3_OUTDIR')
        aws.region = env('AWS_REGION') ?: 'us-east-1'
        // The Batch AMI (Amazon Machine Image) carries the AWS CLI here; Nextflow mounts it
        // into the container to stage files, so the image needs no AWS CLI of its own.
        aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
        // Resubmit jobs whose Spot instance is reclaimed.
        aws.batch.maxSpotAttempts = 5
    }
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    fields = 'name,status,exit,realtime,%cpu,peak_rss,peak_vmem'
}
