# AWS Batch run (nextflow -profile aws). Load with: set -a; source .env; set +a
# Fill in with: terraform -chdir=infra/terraform/training output -raw env (see infra/terraform/README.md)
AWS_REGION=
AWS_BATCH_GPU_QUEUE=
AWS_BATCH_CPU_QUEUE=
AWS_S3_WORKDIR=
AWS_S3_OUTDIR=
# Training image in ECR, tagged with the git commit it was built from
HISTOSTATE_IMAGE=
